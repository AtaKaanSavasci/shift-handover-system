DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shift"
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Registration is closed when empty. Generate a separate 12–128 character code:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REGISTRATION_CODE=""

# Optional JSON request timings; excludes URLs, SQL, parameters and user content.
PERFORMANCE_LOGGING=false

# Optional AI decision support. Disabled unless both enabled and configured.
# Keep the API key on the server; never commit it or put it in public/.
AI_ENABLED=false
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Server port (hosting platforms usually set this) and reverse-proxy hops in front of the app.
PORT=3000
TRUST_PROXY=0

# Public demo: one-click demo sign-in and a daily wipe + reseed of ALL data.
# Only enable on a dedicated demo database.
DEMO_MODE=false
DEMO_LANGUAGE="tr"
DEMO_RESET_HOURS=24
