// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  importFileExtension = "js"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Trigram indexes let the free-text record search (ILIKE %term%) use an index.
  extensions = [pg_trgm]
}

enum Role {
  MANAGER
  SUPERVISOR
  WORKER
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  name       String
  password   String
  role       Role       @default(WORKER)
  active     Boolean    @default(true)
  /// Incremented to revoke every issued token (deactivation, password reset).
  tokenVersion Int      @default(0)
  mustChangePassword Boolean @default(false)
  auditActions AuditLog[]
  createdAt  DateTime   @default(now())
  shifts     Shift[]
  operationEntries OperationEntry[] @relation("EntryAuthor")
  operationUpdates OperationUpdate[]
  workChanges WorkDetailChange[]
  closedEntries OperationEntry[] @relation("EntryCloser")
  equipmentUpdates Equipment[]
  equipmentChanges EquipmentChange[]
  readReceipts HandoverRead[]
}

model Shift {
  id         Int        @id @default(autoincrement())
  startTime  DateTime   @default(now())
  endTime    DateTime?
  status     ShiftStatus @default(ACTIVE)
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  operationEntries OperationEntry[]
  readReceipts HandoverRead[]
  shiftDate String?
  scheduledStart String?
  scheduledEnd String?
  createdAt  DateTime   @default(now())

  // Own history (per user) and the manager view (all users) both page by start time.
  @@index([userId, startTime(sort: Desc), id(sort: Desc)])
  @@index([startTime(sort: Desc), id(sort: Desc)])
  @@unique([userId], map: "Shift_one_active_per_user", where: raw("(status = 'ACTIVE'::\"ShiftStatus\")"))
}




enum EquipmentStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EntryKind {
  EVENT
  NOTE
  VALVE
  ATTENTION
  TASK
}

enum EntryPriority {
  NORMAL
  HIGH
}

model Equipment {
  code String @id
  name String @default("")
  description String @default("") @db.VarChar(300)
  sortOrder Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  status EquipmentStatus @default(UNKNOWN)
  note String @default("")
  version Int @default(0)
  updatedAt DateTime?
  updatedById Int?
  updatedBy User? @relation(fields: [updatedById], references: [id])
  changes EquipmentChange[]
  entries OperationEntry[]
}

model EquipmentChange {
  id Int @id @default(autoincrement())
  equipmentCode String
  equipment Equipment @relation(fields: [equipmentCode], references: [code])
  fromStatus EquipmentStatus
  toStatus EquipmentStatus
  note String
  userId Int
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  // Availability analytics replay each unit's status history.
  @@index([equipmentCode, createdAt])
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  WAITING
}

model OperationEntry {
  id Int @id @default(autoincrement())
  kind EntryKind
  priority EntryPriority @default(NORMAL)
  title String
  description String
  createdAt DateTime @default(now())
  authorId Int
  author User @relation("EntryAuthor", fields: [authorId], references: [id])
  shiftId Int?
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  closedAt DateTime?
  closedById Int?
  closedBy User? @relation("EntryCloser", fields: [closedById], references: [id])
  closeNote String?
  photos OperationPhoto[]
  updates OperationUpdate[]
  workStatus WorkStatus @default(OPEN)
  responsibleTeam String @default("") @db.VarChar(120)
  nextStep String @default("") @db.VarChar(1000)
  workVersion Int @default(0)
  workChanges WorkDetailChange[]
  equipmentCode String?
  equipment Equipment? @relation(fields: [equipmentCode], references: [code])
  @@index([createdAt, id])
  @@index([closedAt, id])
  @@index([equipmentCode, createdAt])
  @@index([closedAt, kind, createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([closeNote(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([priority(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "OperationEntry_open_board_order", where: raw("((\"closedAt\" IS NULL) AND (kind = ANY (ARRAY['TASK'::\"EntryKind\", 'VALVE'::\"EntryKind\", 'ATTENTION'::\"EntryKind\"])))"))
}

model OperationPhoto {
  id String @id @default(uuid())
  entryId Int
  entry OperationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  data Bytes
  createdAt DateTime @default(now())
  @@index([entryId])
}


model OperationRevision {
  id Int @id
  version Int @default(0)
}

model HandoverRead {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  shiftId Int
  shift Shift @relation(fields: [shiftId], references: [id])
  revision Int
  readAt DateTime @default(now())
  snapshot Json
  @@unique([userId, shiftId, revision])
}

model OperationUpdate {
  id Int @id @default(autoincrement())
  entryId Int
  entry OperationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId Int
  author User @relation(fields: [authorId], references: [id])
  body String @db.VarChar(2000)
  requestId String @db.Uuid
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@unique([authorId, requestId])
  @@index([entryId, createdAt, id])
}

model WorkDetailChange {
  id Int @id @default(autoincrement())
  entryId Int
  entry OperationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId Int
  author User @relation(fields: [authorId], references: [id])
  version Int
  workStatus WorkStatus
  responsibleTeam String @db.VarChar(120)
  nextStep String @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@unique([entryId, version])
  @@index([entryId, createdAt, id])
  @@index([createdAt, id])
}

/// Administrative changes: users, roles, passwords and units.
model AuditLog {
  id Int @id @default(autoincrement())
  actorId Int
  actor User @relation(fields: [actorId], references: [id])
  action String @db.VarChar(40)
  targetType String @db.VarChar(20)
  targetId String @db.VarChar(40)
  details Json
  createdAt DateTime @default(now())
  @@index([createdAt, id])
}
